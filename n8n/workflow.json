    {
      "parameters": {
        "jsCode": "const resultados = $input.first().json.resultados;\n  let user_prompt = '';\n  const archivos_citados = new Set();\n  if (resultados.length === 0) {\n    return [{ json: {\n      respuesta: \"No se encuentra esa información en la documentación disponible.\",\n      archivos_citados: [],\n    }}];\n  } else {\n    const system_prompt = `A continuacion se te proveera contexto de documentacion interna y una pregunta.\n    - Tenes que responder solo con la informacion que se te provee.\n    - Si la informacion no responde la pregunta, indica explicitamente que no tenes la informacion suficiente para responderlo. No inventes ni agregues datos extra.\n    - Cita el documento de donde sacas la informacion.`;\n    for (const r of resultados) {\n      user_prompt += `Fuente: ${r.archivo_origen} \\n`;\n      user_prompt += r.texto;\n      user_prompt += ' \\n - - - - - - - - - \\n';\n      archivos_citados.add(r.archivo_origen);\n    }\n    user_prompt += `\\n PREGUNTA DEL USUARIO: ${$input.first().json.query}`;\n    return [{ json: {\n      system_prompt: system_prompt,\n      user_prompt: user_prompt,\n      archivos_citados: [...archivos_citados]\n    }}];\n  }"
      },
